{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HrmsDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "SqliteConnection": "Data Source=hrms.db"
  },
  "Jwt": {
    "Key": "PLACEHOLDER_SET_VIA_ENVIRONMENT_OR_USER_SECRETS",
    "Issuer": "HrmsApi",
    "Audience": "HrmsClient",
    "ExpiresInHours": 24
  },
  "Leave": {
    "AnnualAllocation": 24
  },
  "Attendance": {
    "TimeZone": "Asia/Kolkata",
    "RegularizationWindowDays": 7,
    "ShiftStartTime": "09:30",
    "GracePeriodMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "Storage": {
    "DocumentsPath": "Storage/Documents"
  }
}
